From 1d57723e386345acc8597b49c5824197188dafcb Mon Sep 17 00:00:00 2001
From: Stefan <82128349+coffeelb@users.noreply.github.com>
Date: Sun, 6 Sep 2026 08:54:05 +0800
Subject: [PATCH] iwinfo: mtk: fix UCI string use-after-free issue

mtk_dev2phy() returned a pointer owned by the UCI context after
iwinfo_uci_free() had already freed it, so every caller got a dangling
phy name. Copy the resolved name into a caller-provided buffer instead.

mtk_get_hwmodelist() and mtk_get_htmodelist() also compared the "band"
option string after freeing the UCI context; compare it before the free.

Signed-off-by: coffeelb <coffeelb@users.noreply.github.com>
Co-authored-by: coffeelb <coffeelb@users.noreply.github.com>
---
 package/network/utils/iwinfo/src/iwinfo_mtk.c | 114 +++++++++---------
 1 file changed, 56 insertions(+), 58 deletions(-)

diff --git a/package/network/utils/iwinfo/src/iwinfo_mtk.c b/package/network/utils/iwinfo/src/iwinfo_mtk.c
index 23f01351375..56759bcb627 100644
--- a/package/network/utils/iwinfo/src/iwinfo_mtk.c
+++ b/package/network/utils/iwinfo/src/iwinfo_mtk.c
@@ -11,23 +11,32 @@ static inline int mtk_ioctl(const char *ifname, int cmd, struct iwreq *wrq)
 	return iwinfo_ioctl(cmd, wrq);
 }
 
-static const char *mtk_dev2phy(const char *devname)
+static int mtk_dev2phy(const char *devname, char *phy, size_t len)
 {
-	const char *phy = NULL;
 	struct uci_section *s;
+	const char *value;
+	int ret = -1;
+
+	if (!devname || !phy || !len)
+		return -1;
 
-	if (strstr(devname,"ra") || strstr(devname,"apcli"))
-		return devname;
+	if (strstr(devname,"ra") || strstr(devname,"apcli")) {
+		snprintf(phy, len, "%s", devname);
+		return 0;
+	}
 
 	s = iwinfo_uci_get_radio(devname, "mtwifi");
-	if (!s)
-		goto out;
-	
-	phy = uci_lookup_option_string(uci_ctx, s, "phy");
+	if (s) {
+		value = uci_lookup_option_string(uci_ctx, s, "phy");
+		if (value && value[0]) {
+			snprintf(phy, len, "%s", value);
+			ret = 0;
+		}
+	}
 
-out:
 	iwinfo_uci_free();
-	return phy;
+
+	return ret;
 }
 
